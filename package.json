{
  "name": "kesharon",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm check:architecture && pnpm lint && pnpm test && pnpm build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lint": "pnpm -r --if-present lint",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "prepare:sidecar:release": "node scripts/prepare-sidecar.mjs --release",
    "test": "pnpm test:architecture && pnpm test:tooling && pnpm -r --if-present test",
    "test:architecture": "node --test scripts/check-architecture.test.mjs",
    "test:tooling": "node --test scripts/prepare-sidecar.test.mjs"
  }
}
